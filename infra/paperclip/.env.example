# Copy to .env and replace every GENERATE_* value.
# Keep .env private (chmod 600); never commit real values.
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:sha-353945c86daedc13de0f23bdf8baf1e35f718e71
PAPERCLIP_PORT=3100
# Set this to the private HTTPS hostname in front of the localhost-only port.
PAPERCLIP_PUBLIC_URL=https://paperclip.YOUR-TAILNET.ts.net

# Generate four independent values using: openssl rand -hex 32
PAPERCLIP_DB_PASSWORD=GENERATE_64_HEX_CHAR_SECRET
BETTER_AUTH_SECRET=GENERATE_64_HEX_CHAR_SECRET
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=GENERATE_64_HEX_CHAR_SECRET
PAPERCLIP_AGENT_JWT_SECRET=GENERATE_64_HEX_CHAR_SECRET
